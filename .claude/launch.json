{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "review-hub",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "review"
      ],
      "port": 8765
    },
    {
      "name": "prototypes",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--directory",
        "design/prototypes"
      ],
      "port": 8766
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "codebase/apps/api",
        "start"
      ],
      "port": 3001
    },
    {
      "name": "web-merchant",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "codebase/apps/web-merchant",
        "dev"
      ],
      "port": 3000
    }
  ]
}
