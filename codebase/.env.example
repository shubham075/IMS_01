# Local development only. Copy to .env. Never commit real secrets.
NODE_ENV=development

# The API connects as the NON-superuser role so row-level security applies. Migrations use the admin URL.
DATABASE_URL=postgres://idea01_app:idea01_app_dev@localhost:5432/idea01
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/idea01
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=idea01

# API
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
# true when the API is reachable only through the web server / load balancer, which sets X-Forwarded-For
TRUST_PROXY=true
JWT_SECRET=dev-only-change-me-dev-only-change-me
OTP_HMAC_SECRET=dev-only-otp-secret-dev-only-otp-secret
OTP_PROVIDER=mock                 # mock logs the code in the API log; refused when NODE_ENV=production
OTP_MOCK_FIXED_CODE=123456        # dev/test only: every OTP is this code (leave empty for random codes)

# Merchant web (Next.js)
API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Idea01
# Dev only: shows the mock OTP on the login screen. Never set in production.
NEXT_PUBLIC_SHOW_DEV_OTP_HINT=true
NEXT_PUBLIC_DEV_OTP_CODE=123456
# Map tiles for the shop-location picker (OpenStreetMap is fine for development; use a commercial provider for launch)
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
