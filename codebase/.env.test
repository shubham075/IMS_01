OTP_HMAC_SECRET=test-otp-secret-test-otp-secret-123
OTP_PROVIDER=mock
OTP_MOCK_FIXED_CODE=123456
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=silent
