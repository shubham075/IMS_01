{
  "name": "idea01",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "db:psql": "docker compose exec db psql -U postgres idea01",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:migrate": "pnpm --filter @idea01/db migrate",
    "db:reset": "pnpm --filter @idea01/db reset",
    "db:test": "pnpm --filter @idea01/db test",
    "db:seed": "pnpm --filter @idea01/db seed"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2"
  }
}
